{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@isle/ui": ["packages/ui/src/index.ts"],
      "@isle/ui/*": ["packages/ui/src/*"],
      "@isle/api": ["packages/api/src/index.ts"],
      "@panel/*": ["apps/panel/src/*"],
      "@portal/skin-editor": ["packages/types/skin-editor.d.ts"],
      "@portal/map": ["packages/types/map.d.ts"]
    }
  },
  "include": ["packages", "apps", "test", "vitest.config.ts", "aliases.ts"]
}
