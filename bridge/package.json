{
  "name": "theisle-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Tails the StatsLogger NDJSON stream and serves it to the admin web panel.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
